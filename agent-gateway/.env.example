EVENT_TOKEN=replace-with-event-token
ADMIN_TOKEN=replace-with-admin-token
GATEWAY_DB_PATH=/data/gateway.sqlite3

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=replace-with-qdrant-key
QDRANT_COLLECTION=agent_rag_v1

EMBEDDING_BASE_URL=http://embedding-server:8000/v1
EMBEDDING_API_KEY=replace-with-embedding-key
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32

EXA_API_KEY=replace-with-exa-key
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace-with-llm-key
LLM_MODEL=deepseek-v4-pro
ROUTER_MODEL=deepseek-v4-pro
ROUTER_TIMEOUT_MS=30000
ROUTER_MAX_OUTPUT_TOKENS=512
GROUP_WHITELIST=replace-with-comma-separated-group-ids
CONTEXT_WINDOW=16384
MAX_OUTPUT_TOKENS=4096
RAG_EVIDENCE_THRESHOLD=0.03
AGENT_TIMEOUT_MS=90000
