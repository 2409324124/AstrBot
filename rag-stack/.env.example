RAG_DATA_ROOT=/mnt/PM983/astrbot-rag

QDRANT_API_KEY=replace-with-a-long-random-key
EMBEDDING_API_KEY=replace-with-a-long-random-key

ASTRBOT_VECTOR_DB=faiss
ASTRBOT_QDRANT_URL=http://qdrant:6333
ASTRBOT_QDRANT_COLLECTION_PREFIX=astrbot_kb_
ASTRBOT_COMPOSE_FILE=/home/miku/astrbot-deploy/compose.yml
ASTRBOT_SOURCE_ROOT=/home/miku/astrbot-deploy/AstrBot
# Resolve these placeholders to immutable tags or digests before deployment.
ASTRBOT_IMAGE=replace-with-pinned-astrbot-image-or-digest
ASTRBOT_BASE_IMAGE=replace-with-pinned-astrbot-base-image-or-digest
ASTRBOT_RAG_IMAGE=astrbot-local-rag:4.26.5
NAPCAT_IMAGE=replace-with-pinned-napcat-image-or-digest
RAG_BUILD_PROXY=http://127.0.0.1:18081
ASTRBOT_KB_ROOT=/home/miku/astrbot-deploy/AstrBot/data/knowledge_base

EMBEDDING_BASE_URL=http://127.0.0.1:8000/v1
EMBEDDING_DOCKER_BASE_URL=http://embedding-server:8000/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_PATH=/data/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32

# Keep this value in the untracked rag-stack/.env file, never cmd_config.json.
ASTRBOT_WEBSEARCH_EXA_KEY=replace-with-exa-api-key

ASTRBOT_DASHBOARD_URL=http://127.0.0.1:6185/api/v1
ASTRBOT_DASHBOARD_USERNAME=astrbot
ASTRBOT_DASHBOARD_PASSWORD=replace-with-dashboard-password
ASTRBOT_EMBEDDING_PROVIDER_ID=local_bge_m3
AGENT_GATEWAY_ENV_FILE=../agent-gateway/.env.example
AGENT_GATEWAY_ENABLED=false
AGENT_GATEWAY_URL=http://agent-gateway:8090
AGENT_GATEWAY_TOKEN=replace-with-the-same-value-as-EVENT_TOKEN
AGENT_GATEWAY_ADMIN_TOKEN=replace-with-the-same-value-as-ADMIN_TOKEN
